diff --git a/source/3dssinglegame.cpp b/source/3dssinglegame.cpp
new file mode 100644
index 0000000..7352bb8
--- /dev/null
+++ b/source/3dssinglegame.cpp
@@ -0,0 +1,115 @@
+#include <cstdio>
+#include <cstring>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <dirent.h>
+
+#include <3ds.h>
+
+#include "3dsutils.h"
+#include "3dssettings.h"
+#include "3dsfiles.h"
+#include "3dssinglegame.h"
+
+#define SINGLE_GAME_MANIFEST "romfs:/manifest.cfg"
+
+// manifest.cfg, as 3ds-forwarder writes it:
+//   content = "game.sfc"                        (relative to the RomFS root)
+//   data_dir = "sdmc:/saves/snes/<game>"
+
+static bool active = false;
+static char romPath[PATH_MAX];
+static char dataDir[PATH_MAX];
+
+// Reads `key = "value"` into value; returns false for other lines.
+static bool parseLine(const char *line, const char *key, char *value, size_t size)
+{
+    size_t keyLen = strlen(key);
+    while (*line == ' ' || *line == '\t') line++;
+    if (strncmp(line, key, keyLen) != 0) return false;
+    line += keyLen;
+    while (*line == ' ' || *line == '\t') line++;
+    if (*line++ != '=') return false;
+    const char *start = strchr(line, '"');
+    if (!start) return false;
+    const char *end = strrchr(start + 1, '"');
+    if (!end || end == start + 1) return false;
+    size_t len = (size_t)(end - start - 1);
+    if (len >= size) return false;
+    memcpy(value, start + 1, len);
+    value[len] = '\0';
+    return true;
+}
+
+// mkdir -p for "sdmc:/a/b/c".
+static void makeDirs(const char *path)
+{
+    char partial[PATH_MAX];
+    snprintf(partial, sizeof(partial), "%s", path);
+    char *slash = strchr(partial, '/');
+    while (slash && (slash = strchr(slash + 1, '/'))) {
+        *slash = '\0';
+        mkdir(partial, 0777);
+        *slash = '/';
+    }
+    mkdir(partial, 0777);
+}
+
+bool singleGameInit()
+{
+    if (R_FAILED(romfsInit()))
+        return false;
+    session3DS.isRomFsLoaded = true;
+
+    FILE *fp = fopen(SINGLE_GAME_MANIFEST, "r");
+    if (!fp)
+        return false;
+
+    char line[PATH_MAX + 64];
+    romPath[0] = dataDir[0] = '\0';
+    while (fgets(line, sizeof(line), fp)) {
+        line[strcspn(line, "\r\n")] = '\0';
+        if (!parseLine(line, "content", romPath, sizeof(romPath)))
+            parseLine(line, "data_dir", dataDir, sizeof(dataDir));
+    }
+    fclose(fp);
+
+    // "game.sfc" is relative to the RomFS root
+    if (romPath[0] != '\0' && !strchr(romPath, ':')) {
+        char relative[PATH_MAX];
+        snprintf(relative, sizeof(relative), "%s", romPath);
+        snprintf(romPath, sizeof(romPath), "romfs:/%s", relative);
+    }
+
+    active = romPath[0] != '\0' && dataDir[0] != '\0';
+    if (active)
+        makeDirs(dataDir);
+    return active;
+}
+
+bool singleGameActive()
+{
+    return active;
+}
+
+const char *singleGameRomPath()
+{
+    return romPath;
+}
+
+const char *singleGameDataDir()
+{
+    return dataDir;
+}
+
+bool singleGameFlattens(const char *targetDir)
+{
+    static const char *flat[] = { "saves", "savestates", "configs", "screenshots", CHEATS_DIR };
+    if (!active || !targetDir)
+        return false;
+    for (const char *dir : flat) {
+        if (strcmp(targetDir, dir) == 0)
+            return true;
+    }
+    return false;
+}
