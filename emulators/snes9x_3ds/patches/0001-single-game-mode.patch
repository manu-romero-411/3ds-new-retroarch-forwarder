new file mode 100644
index 0000000..a94120a
--- /dev/null
+++ b/source/3dssinglegame.h
@@ -0,0 +1,27 @@
+#ifndef _3DSSINGLEGAME_H_
+#define _3DSSINGLEGAME_H_
+
+// Single-game mode: a CIA made by 3ds-forwarder carries one ROM in its
+// RomFS and a manifest (romfs:/manifest.cfg) saying where the game keeps
+// its data on the SD card. The emulator then boots straight into that
+// game, keeps saves, states, configs and cheats flat in that folder
+// (sdmc:/saves/snes/<game>/game.srm, ...), and leaves out the ROM browser
+// and the online updater.
+
+// Mounts the RomFS and reads the manifest; call first thing in main().
+// Returns true in a single-game CIA.
+bool singleGameInit();
+
+bool singleGameActive();
+
+// The ROM inside the RomFS, e.g. "romfs:/game.sfc".
+const char *singleGameRomPath();
+
+// The game's folder on the SD card (the emulator's root directory).
+const char *singleGameDataDir();
+
+// Whether files of this kind (a subfolder of the root directory: "saves",
+// "savestates", ...) go straight into the game's folder.
+bool singleGameFlattens(const char *targetDir);
+
+#endif
