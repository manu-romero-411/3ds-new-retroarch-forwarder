+#ifndef IS_SALAMANDER
+/*
+ * Single-game ("injected") mode.
+ *
+ * When the CIA carries a RomFS with romfs:/manifest.cfg, RetroArch runs as
+ * a standalone app for one game: the content is loaded from the RomFS and
+ * every writable path (config, saves, states, core options, screenshots)
+ * is the manifest's data_dir, so it never touches sdmc:/retroarch.
+ *
+ * RomFS layout (flat):
+ *   manifest.cfg      content, data_dir, optional system_dir (+ metadata)
+ *   game.<ext>        the content
+ *   retroarch.cfg     seeds data_dir/retroarch.cfg on first boot
+ *   bottom_menu.png   touch screen menu asset, optional
+ *   bezel.png         top screen bezel, optional (+ bezel.cfg, its overlay)
+ *
+ * A bezel.png in data_dir replaces the RomFS one; its overlay file
+ * (data_dir/bezel.cfg) is written next to it when missing.
+ */
+#define CTR_INJECTED_ROOT     "romfs:/"
+#define CTR_INJECTED_MANIFEST CTR_INJECTED_ROOT "manifest.cfg"
+#define CTR_INJECTED_BASE_CFG CTR_INJECTED_ROOT "retroarch.cfg"
+#define CTR_INJECTED_BOTTOM   CTR_INJECTED_ROOT "bottom_menu.png"
+#define CTR_BEZEL_IMAGE       "bezel.png"
+#define CTR_BEZEL_OVERLAY     "bezel.cfg"
+#define CTR_BEZEL_OVERLAY_CFG \
+   "overlays = 1\n" \
+   "overlay0_overlay = \"" CTR_BEZEL_IMAGE "\"\n" \
+   "overlay0_full_screen = true\n" \
+   "overlay0_descs = 0\n"
+
+static bool ctr_romfs_mounted = false;
+static bool ctr_injected      = false;
+static char ctr_injected_content[PATH_MAX_LENGTH];
+static char ctr_injected_data_dir[PATH_MAX_LENGTH];
+
+static void ctr_injected_set_dir(enum default_dirs type, const char *dir)
+{
+   strlcpy(g_defaults.dirs[type], dir, sizeof(g_defaults.dirs[type]));
+}
+
+static void ctr_injected_seed_config(void)
+{
+   void *buf   = NULL;
+   int64_t len = 0;
+
+   if (path_is_valid(g_defaults.path_config)
+         || !path_is_valid(CTR_INJECTED_BASE_CFG))
+      return;
+
+   if (filestream_read_file(CTR_INJECTED_BASE_CFG, &buf, &len) && buf)
+   {
+      filestream_write_file(g_defaults.path_config, buf, len);
+      free(buf);
+   }
+}
+
+/* Returns true if this CIA is a single-game build and sets it up. */
+static bool ctr_injected_setup(struct rarch_main_wrap *params)
+{
+   char content[PATH_MAX_LENGTH];
+   char data_dir[PATH_MAX_LENGTH];
+   char system_dir[PATH_MAX_LENGTH];
+   config_file_t *manifest = NULL;
+
+   if (R_FAILED(romfsInit()))
+      return false;
+   ctr_romfs_mounted = true;
+
+   manifest = config_file_new(CTR_INJECTED_MANIFEST);
+   if (!manifest)
+      return false;
+
+   content[0]    = '\0';
+   data_dir[0]   = '\0';
+   system_dir[0] = '\0';
+   config_get_array(manifest, "content",    content,    sizeof(content));
+   config_get_array(manifest, "data_dir",   data_dir,   sizeof(data_dir));
+   config_get_array(manifest, "system_dir", system_dir, sizeof(system_dir));
+   config_file_free(manifest);
+
+   if (string_is_empty(content) || string_is_empty(data_dir))
+      return false;
+
+   /* One flat folder per game: game.srm, game.state*, game.opt... */
+   path_mkdir(data_dir);
+   ctr_injected_set_dir(DEFAULT_DIR_SRAM,        data_dir);
+   ctr_injected_set_dir(DEFAULT_DIR_SAVESTATE,   data_dir);
+   ctr_injected_set_dir(DEFAULT_DIR_MENU_CONFIG, data_dir);
+   ctr_injected_set_dir(DEFAULT_DIR_REMAP,       data_dir);
+   ctr_injected_set_dir(DEFAULT_DIR_SCREENSHOT,  data_dir);
+   ctr_injected_set_dir(DEFAULT_DIR_PLAYLIST,    data_dir);
+   ctr_injected_set_dir(DEFAULT_DIR_LOGS,        data_dir);
+   ctr_injected_set_dir(DEFAULT_DIR_CACHE,       data_dir);
+   if (string_is_empty(system_dir))
+      ctr_injected_set_dir(DEFAULT_DIR_SYSTEM,   data_dir);
+   else
+   {
+      path_mkdir(system_dir);
+      ctr_injected_set_dir(DEFAULT_DIR_SYSTEM,   system_dir);
+   }
+
+   /* Startup parses every .info file (or their cache) in the core info
+    * folder; a single static core needs none of them. */
+   ctr_injected_set_dir(DEFAULT_DIR_CORE_INFO,   CTR_INJECTED_ROOT);
+   if (path_is_valid(CTR_INJECTED_BOTTOM))
+      ctr_injected_set_dir(DEFAULT_DIR_BOTTOM_ASSETS, CTR_INJECTED_ROOT);
+
+   fill_pathname_join(g_defaults.path_config, data_dir,
+         FILE_PATH_MAIN_CONFIG, sizeof(g_defaults.path_config));
+   ctr_injected_seed_config();
+
+   fill_pathname_join(ctr_injected_content, CTR_INJECTED_ROOT, content,
+         sizeof(ctr_injected_content));
+   strlcpy(ctr_injected_data_dir, data_dir, sizeof(ctr_injected_data_dir));
+   ctr_injected = true;
+
+   if (params)
+   {
+      params->content_path  = ctr_injected_content;
+      params->sram_path     = NULL;
+      params->state_path    = NULL;
+      params->config_path   = NULL;
+      params->libretro_path = NULL;
+      params->flags        &= ~(RARCH_MAIN_WRAP_FLAG_VERBOSE
+                              | RARCH_MAIN_WRAP_FLAG_NO_CONTENT);
+      params->flags        |=   RARCH_MAIN_WRAP_FLAG_TOUCHED;
+   }
+   return true;
+}
+#endif
+
+#ifndef IS_SALAMANDER
+/* The overlay file of the bezel to show, or "" for none. */
+static void ctr_injected_bezel_overlay(char *s, size_t len)
+{
+   char image[PATH_MAX_LENGTH];
+
+   s[0] = '\0';
+   fill_pathname_join(image, ctr_injected_data_dir, CTR_BEZEL_IMAGE, sizeof(image));
+   if (path_is_valid(image))
+   {
+      fill_pathname_join(s, ctr_injected_data_dir, CTR_BEZEL_OVERLAY, len);
+      if (!path_is_valid(s))
+         filestream_write_file(s, CTR_BEZEL_OVERLAY_CFG,
+               (int64_t)strlen(CTR_BEZEL_OVERLAY_CFG));
+   }
+   else if (path_is_valid(CTR_INJECTED_ROOT CTR_BEZEL_IMAGE))
+      strlcpy(s, CTR_INJECTED_ROOT CTR_BEZEL_OVERLAY, len);
+}
+
+/* Runs once the content is loaded (settings and video are up): shows the
+ * game's bezel as a full screen overlay, or turns overlays off. */
+static void frontend_ctr_process_args(int *argc, char *argv[])
+{
+   char overlay[PATH_MAX_LENGTH];
+   settings_t *settings = config_get_ptr();
+
+   if (!ctr_injected || !settings)
+      return;
+
+   ctr_injected_bezel_overlay(overlay, sizeof(overlay));
+   if (string_is_empty(overlay))
+   {
+      configuration_set_bool(settings, settings->bools.input_overlay_enable, false);
+      command_event(CMD_EVENT_OVERLAY_UNLOAD, NULL);
+      return;
+   }
+   configuration_set_string(settings, settings->paths.path_overlay, overlay);
+   configuration_set_bool(settings, settings->bools.input_overlay_enable, true);
+   command_event(CMD_EVENT_OVERLAY_INIT, NULL);
+}
+#endif
+
 static void frontend_ctr_get_env(int* argc, char* argv[],
       void* args, void* params_data)
 {
@@ -138,6 +317,12 @@ static void frontend_ctr_get_env(int* argc, char* argv[],
                       "ctr", sizeof(g_defaults.dirs[DEFAULT_DIR_BOTTOM_ASSETS]));
 
 #ifndef IS_SALAMANDER
+   if (!ctr_injected_setup((struct rarch_main_wrap*)params_data) && ctr_romfs_mounted)
+   {
+      /* A RomFS without a valid manifest: behave like stock RetroArch. */
+      romfsExit();
+      ctr_romfs_mounted = false;
+   }
    dir_check_defaults("custom.ini");
 #endif
 }
@@ -188,6 +373,12 @@ static void frontend_ctr_deinit(void* data)
    gfxTopRightFramebuffers[0] = NULL;
    gfxTopRightFramebuffers[1] = NULL;
    gfxExit();
+
+   if (ctr_romfs_mounted)
+   {
+      romfsExit();
+      ctr_romfs_mounted = false;
+   }
 #endif
 }
 
@@ -632,7 +823,11 @@ frontend_ctx_driver_t frontend_ctx_ctr =
    frontend_ctr_init,            /* init                           */
    frontend_ctr_deinit,          /* deinit                         */
    frontend_ctr_exitspawn,       /* exitspawn                      */
+#ifdef IS_SALAMANDER
    NULL,                         /* process_args                   */
+#else
+   frontend_ctr_process_args,    /* process_args                   */
+#endif
    frontend_ctr_exec,            /* exec                           */
 #ifdef IS_SALAMANDER
    NULL,                         /* set_fork                       */
