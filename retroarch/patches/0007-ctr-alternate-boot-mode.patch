+/* The alternate mode's picture: pixel perfect, for this session only. */
+static void ctr_injected_apply_alt(settings_t *settings)
+{
+   configuration_set_bool(settings,
+         settings->bools.config_save_on_exit, false);
+   configuration_set_bool(settings,
+         settings->bools.video_scale_integer, true);
+   configuration_set_bool(settings, settings->bools.video_smooth, false);
+   configuration_set_uint(settings,
+         settings->uints.video_aspect_ratio_idx, ASPECT_RATIO_SQUARE);
+   video_driver_set_filtering(1, false, false);
+   command_event(CMD_EVENT_VIDEO_SET_ASPECT_RATIO, NULL);
+}
