# Core recipe for packaging/toolchain/build-base.sh.
#
# CORE_NAME     libretro name, as LIBRETRO= in RetroArch's pkg/ctr/Makefile.cores
# CORE_REPO     git repository of the core
# CORE_REF      pinned commit (or tag)
# CORE_SUBDIR   directory to run make in, relative to the repository root
# CORE_MAKEFILE makefile to use there
# CORE_LIB      static library the core build produces for platform=ctr
# CORE_CFLAGS   optional extra C flags (on top of build-base.sh's compat flags)
# CORE_MAKE_ARGS optional extra make arguments (e.g. SUBSET=neogeo for FBNeo)
# CORE_OPTIONS  libretro_core_options.h, relative to the repository root
#               (shipped with the base for the GUI's core options dialog);
#               empty for cores that define their options in code
CORE_NAME=gambatte
CORE_REPO=https://github.com/libretro/gambatte-libretro.git
CORE_REF=77f2567d718b8973d02caa2daa8dce4953faf811
CORE_SUBDIR=.
CORE_MAKEFILE=Makefile
CORE_LIB=gambatte_libretro_ctr.a
CORE_OPTIONS=libgambatte/libretro/libretro_core_options.h
