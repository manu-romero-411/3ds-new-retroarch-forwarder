# MSX / MSX2 cartridges: blueMSX. Its machine definitions, its database and
# the free C-BIOS machines ship with the base (used when no real BIOS is in
# bios/bluemsx/bluemsx/Machines/).
# Its own libretro-common rxml.c clashes with RetroArch's: renamed.
# Format: see gambatte.env.
CORE_NAME=bluemsx
CORE_REPO=https://github.com/libretro/blueMSX-libretro.git
CORE_REF=e3086eb5d36d77fa11704cf53dc176686e70127d
CORE_SUBDIR=.
CORE_MAKEFILE=Makefile.libretro
CORE_LIB=bluemsx_libretro_ctr.a
CORE_OPTIONS=libretro_core_options.h
CORE_SYSTEM_ROOT=system
CORE_SYSTEM_PATHS="bluemsx/Databases:bluemsx/Machines/MSX - C-BIOS:bluemsx/Machines/MSX2 - C-BIOS:bluemsx/Machines/MSX2+ - C-BIOS"
CORE_RENAME_SYMBOLS=rxml_
