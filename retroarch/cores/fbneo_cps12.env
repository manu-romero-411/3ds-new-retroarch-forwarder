# Arcade: FinalBurn Neo, CPS-1 and CPS-2 games only. Its options are defined in code.
# Format: see gambatte.env.
CORE_NAME=fbneo_cps12
CORE_REPO=https://github.com/libretro/FBNeo.git
CORE_REF=a836e52198aa5ce1f54be7b050e44872a1223797
CORE_SUBDIR=src/burner/libretro
CORE_MAKEFILE=Makefile
CORE_LIB=fbneo_cps12_libretro_ctr.a
CORE_OPTIONS=
CORE_MAKE_ARGS="SUBSET=cps12 REGEN_HEADERS=1"
