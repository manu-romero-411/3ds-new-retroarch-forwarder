# Arcade: FinalBurn Neo, Neo Geo games only (the whole FBNeo does not fit the 3DS). BIOS: neogeo.zip. Its options are defined in code.
# Format: see gambatte.env.
CORE_NAME=fbneo_neogeo
CORE_REPO=https://github.com/libretro/FBNeo.git
CORE_REF=a836e52198aa5ce1f54be7b050e44872a1223797
CORE_SUBDIR=src/burner/libretro
CORE_MAKEFILE=Makefile
CORE_LIB=fbneo_neogeo_libretro_ctr.a
CORE_OPTIONS=
CORE_MAKE_ARGS="SUBSET=neogeo REGEN_HEADERS=1"
