# Source revisions of the 3DS homebrew tools bundled with the packages.
# Sourced by build-tools.sh; bump a ref here to update a tool everywhere
# (release packages, install.sh and local toolchain builds).
MAKEROM_REPO=https://github.com/3DSGuy/Project_CTR.git
MAKEROM_REF=makerom-v0.19.0
BANNERTOOL_REPO=https://github.com/CyberYoshi64/bannertool.git
BANNERTOOL_REF=62f582cf9b3afd775ed8faa9405d8d45df06a07e
# Image used to compile the stub (devkitARM + libctru). The stub is an ARM11
# binary for the console, identical whatever machine builds it.
DEVKITARM_IMAGE=devkitpro/devkitarm:latest
# RetroArch release the single-game ("injected") bases are built from, see
# packaging/toolchain/build-base.sh and injector/patches/retroarch/.
RETROARCH_REPO=https://github.com/libretro/RetroArch.git
RETROARCH_REF=v1.22.2
# Bottom screen assets (ctr/bottom_menu.png) packed into each injected CIA.
RETROARCH_ASSETS_REPO=https://github.com/libretro/retroarch-assets.git
RETROARCH_ASSETS_REF=8c918e2872482139273374ef4cc6c7aff34d7585
