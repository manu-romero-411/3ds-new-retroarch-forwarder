# forwarder.rsf
#
# Basado en el AppTemplate.rsf de referencia del propio autor de makerom
# (jakcron, gist 47392b861657746d8448), que es el RSF de ejemplo oficial
# para makerom 0.15+. Se ha mantenido casi todo el bloque técnico
# (AccessControlInfo / ServiceAccessControl / Dependency) tal cual porque
# es una combinación ya probada que arranca correctamente; solo se han
# tocado BasicInfo, RomFs, TitleInfo y Option para este proyecto.
#
# *** CLAVE para el bug de "CIA installation failed" (0xE0E0468E) ***
# FileSystemAccess incluye "DirectSdmc": es el permiso de exheader que le
# falta a un .3dsx lanzado por el Homebrew Launcher, y que SÍ tiene un
# título instalado como CIA con este RSF. Sin él, FSUSER_OpenFile sobre
# rutas de la SD fuera del propio RomFS del proceso devuelve
# "access denied" (Module FS, Summary Invalid Argument, Level Usage).

BasicInfo:
  Title           : Forwarder
  ProductCode     : CTR-P-FWD1
  Logo            : Homebrew   # Nintendo / Licensed / Distributed / iQue / iQueForSystem / Homebrew

RomFs:
  # Debe coincidir con el ROMFS del Makefile (carpeta romfs/ del proyecto).
  RootPath        : romfs

TitleInfo:
  Category        : Application
  # ID de prueba/homebrew de uso común (mismo que usa el RSF de ejemplo de
  # makerom). Pendiente lo que dice el README sobre reservar un rango
  # propio de Title IDs para cuando el backend genere un forwarder por
  # juego: ahí cada .cia deberá llevar un UniqueId distinto para no
  # colisionar entre sí. Para este stub de prueba, con este alcanza.
  UniqueId        : 0xff3ff

Option:
  UseOnSD           : true   # el forwarder se instala y vive en la SD
  FreeProductCode   : true   # sin esto, ProductCode tiene que ser un código real de Nintendo
  MediaFootPadding  : false
  EnableCrypt       : false
  EnableCompress    : true

AccessControlInfo:
  CoreVersion : 2
  DescVersion : 2

  ReleaseKernelMajor : "02"
  ReleaseKernelMinor : "33"

  UseExtSaveData : false

  # FS:USER Archive Access Permissions
  FileSystemAccess:
    - DirectSdmc        # <-- el permiso que faltaba (ver nota arriba)

  MemoryType    : Application
  SystemMode    : 64MB
  IdealProcessor : 0
  AffinityMask   : 1
  Priority       : 16
  MaxCpu         : 0
  HandleTableSize : 0x200
  DisableDebug   : false
  EnableForceDebug : false
  CanWriteSharedPage : true
  CanUsePrivilegedPriority : false
  CanUseNonAlphabetAndNumber : true
  PermitMainFunctionArgument : true
  CanShareDeviceMemory : true
  RunnableOnSleep : false
  SpecialMemoryArrange : true

  SystemModeExt : Legacy    # el stub no necesita memoria extendida de N3DS (eso es cosa de los cores)
  CpuSpeed      : 268MHz
  EnableL2Cache : false
  CanAccessCore2 : false

  IORegisterMapping:
    - 1ff00000-1ff7ffff

  MemoryMapping:
    - 1f000000-1f5fffff:r

  SystemCallAccess:
    ArbitrateAddress: 34
    Break: 60
    CancelTimer: 28
    ClearEvent: 25
    ClearTimer: 29
    CloseHandle: 35
    ConnectToPort: 45
    ControlMemory: 1
    CreateAddressArbiter: 33
    CreateEvent: 23
    CreateMemoryBlock: 30
    CreateMutex: 19
    CreateSemaphore: 21
    CreateThread: 8
    CreateTimer: 26
    DuplicateHandle: 39
    ExitProcess: 3
    ExitThread: 9
    GetCurrentProcessorNumber: 17
    GetHandleInfo: 41
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetProcessIdealProcessor: 6
    GetProcessInfo: 43
    GetResourceLimit: 56
    GetResourceLimitCurrentValues: 58
    GetResourceLimitLimitValues: 57
    GetSystemInfo: 42
    GetSystemTick: 40
    GetThreadContext: 59
    GetThreadId: 55
    GetThreadIdealProcessor: 15
    GetThreadInfo: 44
    GetThreadPriority: 11
    MapMemoryBlock: 31
    OutputDebugString: 61
    QueryMemory: 2
    ReleaseMutex: 20
    ReleaseSemaphore: 22
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    SetThreadPriority: 12
    SetTimer: 27
    SignalEvent: 24
    SleepThread: 10
    UnmapMemoryBlock: 32
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    Backdoor: 123

  # Servicios mínimos: consola (cfg/gsp/hid/apt), SD (fs:USER) y AM para
  # poder instalar/comprobar CIAs (am:net -- es lo máximo a lo que un
  # proceso normal tiene acceso, FBI usa lo mismo).
  ServiceAccessControl:
    - cfg:u
    - fs:USER
    - gsp::Gpu
    - hid:USER
    - ndm:u
    - pxi:dev
    - APT:U
    - ac:u
    - am:net

SystemControlInfo:
  SaveDataSize: 0K
  RemasterVersion: 0
  StackSize: 0x4000

  # Deben corresponderse 1:1 con ServiceAccessControl de arriba, si no el
  # título se queda colgado en el logo de arranque.
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    cfg: 0x0004013000001702
    codec: 0x0004013000001802
    gpio: 0x0004013000001b02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    i2c: 0x0004013000001e02
    mcu: 0x0004013000001f02
    ndm: 0x0004013000002b02
    pdn: 0x0004013000002102
    ptm: 0x0004013000002202
    spi: 0x0004013000002302
