# forwarder.rsf
#
# Based on makerom author jakcron's reference AppTemplate.rsf (gist
# 47392b861657746d8448), the official example RSF for makerom 0.15+. Most of
# the technical block (AccessControlInfo / ServiceAccessControl /
# Dependency) was kept as-is because it's a proven combination that boots
# correctly; only BasicInfo, RomFs, TitleInfo and Option were changed for
# this project.
#
# *** KEY to the "CIA installation failed" (0xE0E0468E) bug ***
# FileSystemAccess includes "DirectSdmc": this is the exheader permission a
# .3dsx launched from the Homebrew Launcher lacks, but a title installed as
# a CIA with this RSF DOES have. Without it, FSUSER_OpenFile on SD paths
# outside the process's own RomFS returns "access denied" (Module FS,
# Summary Invalid Argument, Level Usage).

BasicInfo:
  Title           : Forwarder
  ProductCode     : CTR-P-FWD1
  Logo            : Homebrew   # Nintendo / Licensed / Distributed / iQue / iQueForSystem / Homebrew

RomFs:
  # Must match the Makefile's ROMFS variable (the project's romfs/ folder).
  RootPath        : $(ROMFS_DIR)

TitleInfo:
  Category        : Application
  # Per-forwarder Unique ID, deterministically generated by
  # tools/title_id.py and passed in by build_forwarder.py. Each forwarder
  # gets its own value so they don't collide with each other in the HOME
  # Menu (see tools/title_id.py for the collision-avoidance strategy).
  UniqueId        : $(UNIQUE_ID)

Option:
  UseOnSD           : true   # the forwarder is installed on, and runs from, the SD card
  FreeProductCode   : true   # without this, ProductCode would need to be a real Nintendo code
  MediaFootPadding  : false
  EnableCrypt       : false
  EnableCompress    : true

AccessControlInfo:
  CoreVersion : 2
  DescVersion : 2

  ReleaseKernelMajor : "02"
  ReleaseKernelMinor : "33"

  UseExtSaveData : false

  # FS:USER Archive Access Permissions
  FileSystemAccess:
    - DirectSdmc        # <-- the permission that was missing (see note above)

  MemoryType    : Application
  SystemMode    : 64MB
  IdealProcessor : 0
  AffinityMask   : 1
  Priority       : 16
  MaxCpu         : 0
  HandleTableSize : 0x200
  DisableDebug   : false
  EnableForceDebug : false
  CanWriteSharedPage : true
  CanUsePrivilegedPriority : false
  CanUseNonAlphabetAndNumber : true
  PermitMainFunctionArgument : true
  CanShareDeviceMemory : true
  RunnableOnSleep : false
  SpecialMemoryArrange : true

  SystemModeExt : Legacy    # the stub doesn't need N3DS extended memory (that's up to the cores)
  CpuSpeed      : 268MHz
  EnableL2Cache : false
  CanAccessCore2 : false

  IORegisterMapping:
    - 1ff00000-1ff7ffff

  MemoryMapping:
    - 1f000000-1f5fffff:r

  SystemCallAccess:
    ArbitrateAddress: 34
    Break: 60
    CancelTimer: 28
    ClearEvent: 25
    ClearTimer: 29
    CloseHandle: 35
    ConnectToPort: 45
    ControlMemory: 1
    CreateAddressArbiter: 33
    CreateEvent: 23
    CreateMemoryBlock: 30
    CreateMutex: 19
    CreateSemaphore: 21
    CreateThread: 8
    CreateTimer: 26
    DuplicateHandle: 39
    ExitProcess: 3
    ExitThread: 9
    GetCurrentProcessorNumber: 17
    GetHandleInfo: 41
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetProcessIdealProcessor: 6
    GetProcessInfo: 43
    GetResourceLimit: 56
    GetResourceLimitCurrentValues: 58
    GetResourceLimitLimitValues: 57
    GetSystemInfo: 42
    GetSystemTick: 40
    GetThreadContext: 59
    GetThreadId: 55
    GetThreadIdealProcessor: 15
    GetThreadInfo: 44
    GetThreadPriority: 11
    MapMemoryBlock: 31
    OutputDebugString: 61
    QueryMemory: 2
    ReleaseMutex: 20
    ReleaseSemaphore: 22
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    SetThreadPriority: 12
    SetTimer: 27
    SignalEvent: 24
    SleepThread: 10
    UnmapMemoryBlock: 32
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    Backdoor: 123

  # Minimal services: console (cfg/gsp/hid/apt), SD (fs:USER) and AM to be
  # able to install/check CIAs (am:net -- the most a regular process can
  # get, which is what FBI itself uses).
  ServiceAccessControl:
    - cfg:u
    - fs:USER
    - gsp::Gpu
    - hid:USER
    - ndm:u
    - pxi:dev
    - APT:U
    - ac:u
    - am:net

SystemControlInfo:
  SaveDataSize: 0K
  RemasterVersion: 0
  StackSize: 0x4000

  # Must match ServiceAccessControl above 1:1, otherwise the title hangs on
  # the boot logo.
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    cfg: 0x0004013000001702
    codec: 0x0004013000001802
    gpio: 0x0004013000001b02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    i2c: 0x0004013000001e02
    mcu: 0x0004013000001f02
    ndm: 0x0004013000002b02
    pdn: 0x0004013000002102
    ptm: 0x0004013000002202
    spi: 0x0004013000002302
